<Window x:Class="IdmClone.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utylix Archives" Width="900" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="archive.ico" AllowDrop="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
