<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Utylix</AssemblyName>
    <RootNamespace>IdmClone</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>IdmClone.Program</StartupObject>
    <Version>1.8.0</Version>
    <Authors>Reynan Gonzales</Authors>
    <Company>Reynan Gonzales</Company>
    <Product>Utylix</Product>
    <Copyright>Copyright (c) 2026 Reynan Gonzales</Copyright>
    <Description>Utylix - a personal all-in-one toolbox for Windows</Description>
    <PackageProjectUrl>https://github.com/ReynanGonzales/Utylix</PackageProjectUrl>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="convert.ico" />
    <Resource Include="logo.png" />
    <Resource Include="player.ico" />
    <Resource Include="photos.ico" />
    <Resource Include="music.ico" />
    <Resource Include="music.png" />
    <Resource Include="photos.png" />
    <Resource Include="player.png" />
    <Resource Include="archive.ico" />
    <Resource Include="archive.png" />
    <Resource Include="pdf.ico" />
    <Resource Include="pdf.png" />
    <!-- the browser extension travels inside Utylix.exe and is unpacked into the data folder, so the installer needs no extra files -->
    <EmbeddedResource Include="..\extension\**\*" LogicalName="ext/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- and as real files next to the program (extension\ in the program folder): the installed copy uses those, the embedded copy is for the single-file build -->
    <Content Include="..\extension\**\*" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
