<Window x:Class="IdmClone.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IdmClone"
        Title="Utylix Player" Width="1000" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Icon="player.ico" AllowDrop="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- ============ the menu bar, in the app's colors (the stock menu is white) ============ -->
        <ControlTemplate x:Key="TopHeaderTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Padding="11,6" Background="Transparent">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" CornerRadius="6" Margin="0,0,8,8">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Padding="8,6" Background="Transparent" CornerRadius="4" MinWidth="230">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="28,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubHeaderTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="Bd" Padding="8,6" Background="Transparent" CornerRadius="4" MinWidth="230">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="›" FontSize="16" Margin="28,-2,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-2" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" CornerRadius="6" Margin="0,0,8,8">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template" Value="{StaticResource SubItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource TopHeaderTemplate}" /></Trigger>
                <Trigger Property="Role" Value="SubmenuHeader"><Setter Property="Template" Value="{StaticResource SubHeaderTemplate}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" CornerRadius="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource LineBrush}" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ flat round icon buttons and the sliders ============ -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="22">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="2.5,0,0,2.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="22" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" /></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ menu bar ============ -->
        <Border x:Name="MenuBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Menu x:Name="MenuBar" Background="Transparent" Foreground="{DynamicResource TextBrush}" Margin="4,0" AutomationProperties.AutomationId="PlayerMenu">
                <MenuItem Header="_Media" SubmenuOpened="Menu_Opened">
                    <MenuItem Header="Open _File…" InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                    <MenuItem Header="Open _Multiple Files…" InputGestureText="Ctrl+Shift+O" Click="OpenMany_Click" />
                    <MenuItem Header="Open F_older…" InputGestureText="Ctrl+F" Click="OpenFolder_Click" />
                    <MenuItem Header="Open _Network Stream…" InputGestureText="Ctrl+N" Click="OpenNetwork_Click" />
                    <MenuItem x:Name="RecentMenu" Header="Open _Recent" />
                    <Separator />
                    <MenuItem Header="_Quit" InputGestureText="Ctrl+Q" Click="Quit_Click" />
                </MenuItem>
                <MenuItem Header="_Playback" SubmenuOpened="Menu_Opened">
                    <MenuItem x:Name="PlayPauseItem" Header="_Play / Pause" InputGestureText="Space" Click="PlayPause_Click" />
                    <MenuItem Header="_Stop" InputGestureText="S" Click="Stop_Click" />
                    <MenuItem Header="Pre_vious" InputGestureText="P" Click="Prev_Click" />
                    <MenuItem Header="_Next" InputGestureText="N" Click="Next_Click" />
                    <Separator />
                    <MenuItem Header="_Jump Forward 10 s" InputGestureText="Right" Click="Forward_Click" />
                    <MenuItem Header="Jump _Backward 10 s" InputGestureText="Left" Click="Back_Click" />
                    <MenuItem Header="Jump Forward 1 min" InputGestureText="Ctrl+Right" Click="Forward1_Click" />
                    <MenuItem Header="Jump Backward 1 min" InputGestureText="Ctrl+Left" Click="Back1_Click" />
                    <MenuItem Header="Next Frame" InputGestureText="E" Click="Frame_Click" />
                    <Separator />
                    <MenuItem x:Name="SpeedMenu" Header="S_peed" />
                    <MenuItem x:Name="RepeatMenu" Header="_Repeat">
                        <MenuItem x:Name="RepeatOff" Header="Off" Click="RepeatOff_Click" />
                        <MenuItem x:Name="RepeatAll" Header="Playlist" Click="RepeatAll_Click" />
                        <MenuItem x:Name="RepeatOne" Header="Current file" Click="RepeatOne_Click" />
                    </MenuItem>
                    <MenuItem x:Name="ShuffleItem" Header="Ran_dom" IsCheckable="True" Click="ShuffleItem_Click" />
                </MenuItem>
                <MenuItem Header="_Audio" SubmenuOpened="Menu_Opened">
                    <MenuItem x:Name="AudioTrackMenu" Header="Audio _Track" />
                    <Separator />
                    <MenuItem Header="Volume _Up" InputGestureText="Up" Click="VolUp_Click" />
                    <MenuItem Header="Volume _Down" InputGestureText="Down" Click="VolDown_Click" />
                    <MenuItem x:Name="MuteItem" Header="_Mute" InputGestureText="M" IsCheckable="True" Click="Mute_Click" />
                    <Separator />
                    <MenuItem Header="Audio Delay +50 ms" InputGestureText="K" Click="AudioDelayUp_Click" />
                    <MenuItem Header="Audio Delay −50 ms" InputGestureText="J" Click="AudioDelayDown_Click" />
                </MenuItem>
                <MenuItem Header="_Video" SubmenuOpened="Menu_Opened">
                    <MenuItem x:Name="FullscreenItem" Header="_Fullscreen" InputGestureText="F" Click="Fullscreen_Click" />
                    <MenuItem x:Name="OnTopItem" Header="Always on _Top" InputGestureText="Ctrl+T" IsCheckable="True" Click="OnTop_Click" />
                    <Separator />
                    <MenuItem x:Name="AspectMenu" Header="Aspect _Ratio" />
                    <MenuItem x:Name="ZoomMenu" Header="_Zoom" />
                    <Separator />
                    <MenuItem Header="Take _Snapshot" InputGestureText="Shift+S" Click="Snapshot_Click" />
                </MenuItem>
                <MenuItem Header="_Subtitle" SubmenuOpened="Menu_Opened">
                    <MenuItem Header="_Add Subtitle File…" Click="AddSubtitle_Click" />
                    <MenuItem x:Name="SubTrackMenu" Header="Sub _Track" />
                    <Separator />
                    <MenuItem Header="Subtitle Delay +50 ms" InputGestureText="H" Click="SubDelayUp_Click" />
                    <MenuItem Header="Subtitle Delay −50 ms" InputGestureText="G" Click="SubDelayDown_Click" />
                    <MenuItem Header="Next Subtitle Track" InputGestureText="V" Click="NextSub_Click" />
                </MenuItem>
                <MenuItem Header="V_iew">
                    <MenuItem x:Name="PlaylistMenuItem" Header="_Playlist" InputGestureText="Ctrl+L" IsCheckable="True" Click="Playlist_Click" />
                    <MenuItem x:Name="MinimalItem" Header="_Minimal View" InputGestureText="Ctrl+H" IsCheckable="True" Click="Minimal_Click" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Keyboard Shortcuts" Click="Shortcuts_Click" />
                    <MenuItem Header="_About Utylix Player" Click="About_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ============ the picture, and the playlist on the right ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlaylistColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Background="Black">
                <Grid>
                    <local:VlcHost x:Name="Video" Visibility="Hidden" />
                    <StackPanel x:Name="IdlePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="player.png" Width="112" Height="112" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="IdleText" Text="Drop a video or music file here, or press Ctrl+O" Foreground="#8B93A5" FontSize="15" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="PlaylistPanel" Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Playlist" FontWeight="SemiBold" FontSize="15" Margin="14,12,14,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,8,10,10">
                        <Button Content="Add files…" Style="{StaticResource DialogButton}" MinWidth="0" Padding="12,0" Click="AddToList_Click" />
                        <Button Content="Remove" Style="{StaticResource DialogButton}" MinWidth="0" Padding="12,0" Margin="8,0,0,0" Click="RemoveFromList_Click" />
                        <Button Content="Clear" Style="{StaticResource DialogButton}" MinWidth="0" Padding="12,0" Margin="8,0,0,0" Click="ClearList_Click" />
                    </StackPanel>
                    <ListBox x:Name="PlaylistBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ItemContainerStyle="{StaticResource ListRow}"
                             Margin="6,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="PlaylistBox_DoubleClick" KeyDown="PlaylistBox_KeyDown"
                             AutomationProperties.AutomationId="PlayerPlaylist">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Marker}" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ the controls (moved into a small window on top of the picture in full screen) ============ -->
        <Border x:Name="ControlsBar" Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6,12,8">
            <StackPanel>
                <Grid Margin="4,0,4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeText" Text="0:00" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Width="58" AutomationProperties.AutomationId="PlayerTime" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" Style="{StaticResource BarSlider}" ValueChanged="Seek_ValueChanged" IsEnabled="False"
                            AutomationProperties.AutomationId="PlayerSeek" />
                    <TextBlock x:Name="LengthText" Grid.Column="2" Text="0:00" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" Width="58" AutomationProperties.AutomationId="PlayerLength" />
                </Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute_Click" ToolTip="Mute (M)" AutomationProperties.AutomationId="PlayerMute" />
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="150" Value="100" Style="{StaticResource BarSlider}" ValueChanged="Volume_ValueChanged" AutomationProperties.AutomationId="PlayerVolume" />
                        <TextBlock x:Name="VolumeText" Text="100%" Width="46" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <Button x:Name="PlaylistBtn" Style="{StaticResource IconButton}" Content="&#xE14C;" Click="Playlist_Click" ToolTip="Playlist (Ctrl+L)" Margin="6,0,0,0" AutomationProperties.AutomationId="PlayerPlaylistBtn" />
                        <Button x:Name="FullscreenBtn" Style="{StaticResource IconButton}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="Fullscreen (F)" AutomationProperties.AutomationId="PlayerFullscreen" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Click="PlayPause_Click" ToolTip="Play / Pause (Space)" Width="46" AutomationProperties.AutomationId="PlayerPlay" />
                        <Button x:Name="StopBtn" Style="{StaticResource IconButton}" Content="&#xE71A;" Click="Stop_Click" ToolTip="Stop (S)" AutomationProperties.AutomationId="PlayerStop" />
                        <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous (P)" AutomationProperties.AutomationId="PlayerPrev" />
                        <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next (N)" AutomationProperties.AutomationId="PlayerNext" />
                        <ToggleButton x:Name="ShuffleBtn" Style="{StaticResource IconToggle}" Content="&#xE8B1;" Click="Shuffle_Click" ToolTip="Random" Margin="6,0,0,0" AutomationProperties.AutomationId="PlayerShuffle" />
                        <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Content="&#xE8EE;" Click="Repeat_Click" ToolTip="Repeat: off" Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="PlayerRepeat" />
                        <Button x:Name="SpeedBtn" Style="{StaticResource DialogButton}" Content="1.00×" Click="SpeedReset_Click" ToolTip="Playback speed ( [ slower, ] faster, = normal )" MinWidth="0" Width="64" Height="28" Margin="10,0,0,0"
                                Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="PlayerSpeed" />
                        <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" AutomationProperties.AutomationId="PlayerStatus" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
