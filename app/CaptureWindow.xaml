<Window x:Class="IdmClone.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utylix - New download" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="app.ico" ShowInTaskbar="True" ShowActivated="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5">
    <StackPanel Margin="22,20,22,20">

        <!-- What is being downloaded: type tile, size, and speed/host info -->
        <Grid Margin="2,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Tile" Width="56" Height="56" CornerRadius="13" Background="{DynamicResource AccentBrush}"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <TextBlock x:Name="GlyphText" Text="📦" FontSize="26" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="IconImage" Width="40" Height="40" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SizeHeadline" FontSize="19" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="File name" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Field}"
                         TextChanged="NameBox_TextChanged" />

                <TextBlock x:Name="CatLabel" Grid.Row="1" Text="Save as" Margin="0,14,0,0" Foreground="{DynamicResource MutedBrush}" />
                <WrapPanel x:Name="CatPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,11,0,0" />

                <!-- pictures only: turn the download into another format once it has arrived -->
                <TextBlock x:Name="ConvLabel" Grid.Row="2" Text="Convert to" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}"
                           Visibility="Collapsed" />
                <StackPanel x:Name="ConvPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" Visibility="Collapsed">
                    <WrapPanel x:Name="ConvChips" />
                    <CheckBox x:Name="KeepBox" Content="Keep the original picture too" Margin="0,2,0,6" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Save to" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
                <TextBox x:Name="DirBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Margin="0,8,0,0"
                         TextChanged="DirBox_TextChanged" />
                <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Style="{StaticResource DialogButton}"
                        Margin="10,8,0,0" Click="Browse_Click" />

                <!-- what to do once it has finished -->
                <TextBlock Grid.Row="4" Text="When done" Margin="0,15,0,0" Foreground="{DynamicResource MutedBrush}" />
                <WrapPanel x:Name="AfterChips" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrBrush}" TextWrapping="Wrap" Margin="2,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="LaterBtn" Content="Download later" Style="{StaticResource DialogButton}" Margin="0,0,10,0"
                    IsEnabled="False" Click="Later_Click" />
            <Button x:Name="StartBtn" Content="Start download" Style="{StaticResource DialogPrimary}"
                    IsDefault="True" IsEnabled="False" Click="Start_Click" />
        </StackPanel>
    </StackPanel>
</Window>
