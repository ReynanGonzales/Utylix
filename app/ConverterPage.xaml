<UserControl x:Class="IdmClone.ConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent" Drop="Window_Drop" DragOver="Window_DragOver">
    <UserControl.Resources>
        <!-- quiet list rows that follow the app theme (the stock ListBox uses system blue/white) -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBrush}" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DialogButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <Button x:Name="ConvertBtn" Content="Convert" Style="{StaticResource DialogPrimary}" IsDefault="True" MinWidth="110" Click="Convert_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="ShowBtn" Content="Show in folder" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                            Visibility="Collapsed" VerticalAlignment="Center" Click="ShowFolder_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding AppIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Multi Convert" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Change pictures, videos and music into another format. Your originals are never changed."
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- files -->
            <Border Grid.Row="1" Style="{StaticResource Section}" Margin="0,14,0,10" Padding="12" MinHeight="120">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add files…" Style="{StaticResource DialogButton}" Click="Add_Click" />
                        <Button x:Name="RemoveBtn" Content="Remove selected" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Remove_Click" />
                        <Button x:Name="ClearBtn" Content="Clear" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Clear_Click" />
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                 ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="FileList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" Width="230"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="12,0,0,0" ToolTip="{Binding Status}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="🎞" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="Drop pictures, videos or music here, or click Add files…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="PNG, JPG, WebP … · MP4, MKV, AVI, MOV … · MP3, FLAC, WAV, M4A …" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- options -->
            <Border Grid.Row="2" Style="{StaticResource Section}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Convert to" FontWeight="SemiBold" VerticalAlignment="Center" Width="90" />
                        <WrapPanel x:Name="KindChips" />
                    </StackPanel>
                    <WrapPanel x:Name="FormatChips" />
                    <TextBlock x:Name="FormatNote" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <!-- video and music need ffmpeg (a free helper, about 100 MB, downloaded once) -->
                    <Border x:Name="FfmpegBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,9" CornerRadius="8"
                            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button x:Name="InstallBtn" DockPanel.Dock="Right" Content="Install ffmpeg" Style="{StaticResource DialogPrimary}" Margin="12,0,0,0" Click="InstallFfmpeg_Click" />
                            <TextBlock x:Name="FfmpegText" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Videos and music are converted with ffmpeg, a free open-source helper (about 100 MB, downloaded once and checked against its published checksum)." />
                        </DockPanel>
                    </Border>

                    <!-- pictures -->
                    <Grid x:Name="QualityRow" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality" VerticalAlignment="Center" />
                        <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="40" Maximum="100" Value="90" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Quality_Changed" />
                        <TextBlock x:Name="QualityText" Grid.Column="2" Text="90" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="SizeRow" Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="ResizeBox" Content="Make smaller: longest side at most" VerticalAlignment="Center" Checked="Resize_Changed" Unchecked="Resize_Changed" />
                        <TextBox x:Name="SideBox" Style="{StaticResource Field}" Width="80" Margin="10,0,6,0" Text="1920" IsEnabled="False" />
                        <TextBlock Text="pixels (pictures are never enlarged)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>

                    <!-- video -->
                    <StackPanel x:Name="VideoRow" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="VideoQualityRow" Orientation="Horizontal">
                            <TextBlock Text="Quality" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <WrapPanel x:Name="VideoQualityChips" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Size" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <WrapPanel x:Name="VideoSizeChips" />
                        </StackPanel>
                    </StackPanel>

                    <!-- music -->
                    <StackPanel x:Name="AudioRow" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Quality" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <WrapPanel x:Name="AudioQualityChips" />
                    </StackPanel>

                    <TextBlock Text="Save to" FontWeight="SemiBold" Margin="0,12,0,8" />
                    <RadioButton x:Name="SameFolderRadio" GroupName="dest" IsChecked="True" Foreground="{DynamicResource TextBrush}"
                                 Content="Next to each original file" Checked="Dest_Changed" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="OtherFolderRadio" GroupName="dest" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                     Content="This folder:" Checked="Dest_Changed" />
                        <TextBox x:Name="OutBox" Grid.Column="1" Style="{StaticResource Field}" Margin="12,0,0,0" IsEnabled="False" />
                        <Button x:Name="OutBrowse" Grid.Column="2" Content="Browse…" Style="{StaticResource DialogButton}" Margin="10,0,0,0"
                                IsEnabled="False" Click="Browse_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
