<UserControl x:Class="IdmClone.RecorderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- quiet list rows that follow the app theme (the stock ListBox uses system blue/white) -->
        <Style x:Key="WindowRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <Grid>
                <TextBlock Text="Screen Recorder" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ShortcutHint" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
            </Grid>

            <!-- what and how to record -->
            <Border Style="{StaticResource Section}" Margin="0,14,0,10" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Record" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="ModeChips" />
                    </StackPanel>
                    <StackPanel x:Name="MonitorRow" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Screen" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="MonitorChips" />
                    </StackPanel>
                    <TextBlock x:Name="ModeNote" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="90,2,0,0" TextWrapping="Wrap" />

                    <!-- Window mode: pick the program window to record -->
                    <StackPanel x:Name="WindowRow" Margin="90,6,0,0" Visibility="Collapsed">
                        <ListBox x:Name="WindowsBox" MaxHeight="200" ItemContainerStyle="{StaticResource WindowRow}" Padding="3"
                                 Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource TextBrush}"
                                 SelectionChanged="Window_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="RecWindows">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="WindowTitle" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DockPanel Margin="0,4,0,0">
                            <Button Content="Refresh list" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Click="RefreshWindows_Click" />
                            <TextBlock x:Name="WindowNote" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Sound" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <CheckBox x:Name="SystemBox" Content="System sound" Margin="0,0,22,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <CheckBox x:Name="MicBox" Content="Microphone" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="MicRow" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Microphone" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="MicChips" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Format" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="FormatChips" />
                    </StackPanel>
                    <StackPanel x:Name="QualityRow" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Quality" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="QualityChips" />
                    </StackPanel>
                    <StackPanel x:Name="FpsRow" Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Frame rate" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="FpsChips" />
                    </StackPanel>
                    <TextBlock x:Name="FormatNote" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="90,2,0,0" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Countdown" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" />
                        <WrapPanel x:Name="CountdownChips" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Mouse" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <CheckBox x:Name="CursorBox" Content="Show the pointer" Margin="0,0,22,0" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                        <CheckBox x:Name="ClicksBox" Content="Highlight clicks" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="On screen" Width="90" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <CheckBox x:Name="FrameBox" Content="Red frame and REC tag around what is recorded (never in the video)" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed" />
                    </StackPanel>

                    <!-- recording needs ffmpeg (a free helper, about 100 MB, downloaded once) -->
                    <Border x:Name="FfmpegBanner" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,9" CornerRadius="8"
                            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button x:Name="InstallBtn" DockPanel.Dock="Right" Content="Install ffmpeg" Style="{StaticResource DialogPrimary}" Margin="12,0,0,0" Click="InstallFfmpeg_Click" />
                            <TextBlock x:Name="FfmpegText" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Recording uses ffmpeg, a free open-source helper (about 100 MB, downloaded once and checked against its published checksum)." />
                        </DockPanel>
                    </Border>

                    <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" Content="⏺   Start recording" Height="46" HorizontalAlignment="Left" MinWidth="200"
                            Margin="0,16,0,0" Click="Start_Click" AutomationProperties.AutomationId="RecStart" />
                </StackPanel>
            </Border>

            <!-- the last recording -->
            <Border Style="{StaticResource Section}" Padding="16,14">
                <Grid>
                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" Margin="0,16">
                        <TextBlock Text="🎬" FontSize="38" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <DockPanel x:Name="LastPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▶  Play" Style="{StaticResource DialogPrimary}" Click="Play_Click" />
                            <Button Content="Show in folder" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="Show_Click" />
                            <Button x:Name="DeleteBtn" Content="🗑  Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click" ToolTip="Moves the recording to the Recycle Bin"
                                    AutomationProperties.AutomationId="RecDelete" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Last recording" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" />
                            <TextBlock x:Name="LastName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="RecLastName" />
                            <TextBlock x:Name="LastInfo" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" AutomationProperties.AutomationId="RecLastInfo" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
