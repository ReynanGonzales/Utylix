<Window x:Class="IdmClone.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utylix - yt-dlp update" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="app.ico" ShowInTaskbar="True" ShowActivated="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5">
    <StackPanel Margin="24,22,24,22">
        <TextBlock Text="A newer yt-dlp is available" FontSize="19" FontWeight="SemiBold" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LaterBtn" Content="Later" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,10,0" Click="Later_Click" />
            <Button x:Name="UpdateBtn" Content="Update now" Style="{StaticResource DialogPrimary}" IsDefault="True" Click="Update_Click" />
        </StackPanel>
    </StackPanel>
</Window>
