<Window x:Class="IdmClone.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utylix" Width="900" Height="700" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" Icon="app.ico" AllowDrop="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5">
    <Window.Resources>
        <!-- one tab in the top bar: quiet text, accent underline on the selected one -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{DynamicResource BgBrush}" CornerRadius="8" Margin="0,7,0,9" Opacity="0" />
                            <ContentPresenter x:Name="Cp" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Border x:Name="Line" Height="3" CornerRadius="2,2,0,0" VerticalAlignment="Bottom" Margin="14,0"
                                    Background="{DynamicResource AccentBrush}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                                <Setter TargetName="Hover" Property="Opacity" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- flat button at the right end of the bar -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Height="48">
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="0,0,10,0" VerticalAlignment="Center"
                        Content="⚙  Settings" Click="Settings_Click" />
                <Image Source="logo.png" DockPanel.Dock="Left" Width="26" Height="26" Margin="16,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel x:Name="Tabs" Orientation="Horizontal" />
            </DockPanel>
        </Border>

        <!-- shown only when Utylix was started "as administrator": Windows then refuses drag and drop from a normal Explorer -->
        <Border x:Name="ElevatedBar" Grid.Row="1" Visibility="Collapsed" Background="#FFF4CE" BorderBrush="#E0C36A" BorderThickness="0,0,0,1" Padding="16,8">
            <TextBlock Foreground="#5A4500" TextWrapping="Wrap"
                       Text="Utylix is running as administrator, so Windows blocks dragging files into it from Explorer (and the browser link may not work). Close it and open it normally: Start menu, or the Utylix tray icon after signing in again." />
        </Border>

        <!-- the selected tool -->
        <ContentControl x:Name="Host" Grid.Row="2" IsTabStop="False" AllowDrop="True" />
    </Grid>
</Window>
