<Window x:Class="IdmClone.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Utylix Snip" Width="520" Height="200" MinWidth="500" MinHeight="190" Icon="logo.png"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" UseLayoutRounding="True">
    <Window.Resources>
        <!-- the drop-down menus (Mode, Delay) in the app's colors: the stock menu is white -->
        <ControlTemplate x:Key="MenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Padding="8,6" Background="Transparent" CornerRadius="4" MinWidth="190">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Check" Text="&#x2713;" Visibility="Collapsed" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SnipMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template" Value="{StaticResource MenuItemTemplate}" />
        </Style>
        <Style x:Key="SnipMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="4" CornerRadius="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SnipSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource LineBrush}" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- flat toolbar button, like the classic Snipping Tool -->
        <Style x:Key="SnipButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SnipToggle" TargetType="ToggleButton" BasedOn="{StaticResource SnipButton}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource LineBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Opacity="0" />
                            <Ellipse Fill="{TemplateBinding Background}" Margin="3" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- New | Mode | Delay | Cancel | Options -->
        <StackPanel Orientation="Horizontal" Margin="8,8,8,6">
            <Button x:Name="NewBtn" Style="{StaticResource SnipButton}" Click="New_Click" AutomationProperties.AutomationId="SnipNew" ToolTip="Take a snip (Ctrl + N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2702;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#D4392F" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="New" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="ModeBtn" Style="{StaticResource SnipButton}" Click="Mode_Click" AutomationProperties.AutomationId="SnipMode" ToolTip="What to snip">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C3;" Style="{StaticResource Glyph}" Foreground="#1B6EC2" />
                    <TextBlock Text="Mode" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,2,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="DelayBtn" Style="{StaticResource SnipButton}" Click="Delay_Click" AutomationProperties.AutomationId="SnipDelay" ToolTip="Wait a few seconds first">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Delay" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,2,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelBtn" Style="{StaticResource SnipButton}" Click="Cancel_Click" IsEnabled="False" AutomationProperties.AutomationId="SnipCancel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="OptionsBtn" Style="{StaticResource SnipButton}" Click="Options_Click" AutomationProperties.AutomationId="SnipOptions">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="Options" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- after a snip: save, copy, pen ... -->
        <Border x:Name="EditBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="8,5">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource SnipButton}" Click="Save_Click" AutomationProperties.AutomationId="SnipSave" ToolTip="Save (saves a file in the Screenshots folder)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="#1B6EC2" /><TextBlock Text="Save" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SnipButton}" Click="SaveAs_Click" AutomationProperties.AutomationId="SnipSaveAs" ToolTip="Save as… (Ctrl + S)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE792;" Style="{StaticResource Glyph}" Foreground="#1B6EC2" /><TextBlock Text="Save as…" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SnipButton}" Click="Copy_Click" AutomationProperties.AutomationId="SnipCopy" ToolTip="Copy (Ctrl + C)">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" Foreground="#1B6EC2" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,2" />
                <ToggleButton x:Name="PenBtn" Style="{StaticResource SnipToggle}" IsChecked="True" Click="Pen_Click" ToolTip="Pen">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76D;" Style="{StaticResource Glyph}" Foreground="#D4392F" /><TextBlock Text="Pen" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="HighlightBtn" Style="{StaticResource SnipToggle}" Click="Highlight_Click" ToolTip="Highlighter">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E6;" Style="{StaticResource Glyph}" Foreground="#E0A800" /><TextBlock Text="Highlighter" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="EraserBtn" Style="{StaticResource SnipToggle}" Click="Eraser_Click" ToolTip="Eraser">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE75C;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="Eraser" VerticalAlignment="Center" /></StackPanel>
                </ToggleButton>
                <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button x:Name="SizeBtn" Style="{StaticResource SnipButton}" Click="Size_Click" ToolTip="Pen thickness">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B8;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="SizeText" Text="M" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button Style="{StaticResource SnipButton}" Click="Undo_Click" ToolTip="Undo the last mark">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="Undo" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,2" />
                <Button Style="{StaticResource SnipButton}" Click="Detect_Click" AutomationProperties.AutomationId="SnipDetect" ToolTip="Read the text in the picture">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D2;" Style="{StaticResource Glyph}" Foreground="#1B6EC2" /><TextBlock Text="Detect text" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- the message, or the picture -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid x:Name="Message" Margin="10,8,10,8">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="MessageText" AutomationProperties.AutomationId="SnipMessage" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,30,0"
                                   Text="Select the snip mode using the Mode button or click the New button." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock><Hyperlink Foreground="{DynamicResource AccentBrush}" Click="Open_Click">Open a picture…</Hyperlink></TextBlock>
                            <TextBlock Margin="14,0,0,0"><Hyperlink Foreground="{DynamicResource AccentBrush}" Click="Paste_Click">Paste a picture</Hyperlink></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" ToolTip="Win + S also takes a snip from anywhere">
                        <TextBlock Text="?" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ScrollViewer x:Name="PictureHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgBrush}">
                    <Grid x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="Preview" Stretch="Fill" />
                        <InkCanvas x:Name="Ink" Background="Transparent" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- detected text -->
        <Border x:Name="TextPanel" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy text" Style="{StaticResource SnipButton}" Click="CopyText_Click" />
                        <Button Content="Hide" Style="{StaticResource SnipButton}" Click="HideText_Click" />
                    </StackPanel>
                    <TextBlock Text="Detected text" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TextStatus" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                </DockPanel>
                <TextBox x:Name="Detected" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="150" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
