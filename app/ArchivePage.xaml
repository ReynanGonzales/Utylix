<UserControl x:Class="IdmClone.ArchivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent" Drop="Page_Drop" DragOver="Page_DragOver">
    <UserControl.Resources>
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- bottom bar: progress, status, actions -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBrush}" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource DialogButton}" Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click" />
                    <StackPanel x:Name="ExtractActions" Orientation="Horizontal">
                        <Button x:Name="TestBtn" Content="Test archive" Style="{StaticResource DialogButton}" Click="Test_Click" />
                        <Button x:Name="ExtractSelBtn" Content="Extract selected" Style="{StaticResource DialogButton}" Margin="10,0,0,0" Click="ExtractSelected_Click" />
                        <Button x:Name="ExtractAllBtn" Content="Extract all" Style="{StaticResource DialogPrimary}" Margin="10,0,0,0" MinWidth="110" Click="ExtractAll_Click" />
                    </StackPanel>
                    <Button x:Name="CreateBtn" Content="Create archive" Style="{StaticResource DialogPrimary}" MinWidth="130" Visibility="Collapsed" Click="Create_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar x:Name="Progress" Height="6" Margin="0,0,0,6" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                        <Button x:Name="ShowBtn" Content="Show in folder" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Visibility="Collapsed" Click="ShowFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel>
                <WrapPanel x:Name="ModeChips" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="30" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Archives" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Open and extract ZIP, RAR, 7z, TAR …  ·  create ZIP and TAR.GZ files." Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ================= extract ================= -->
            <Grid x:Name="ExtractPanel" Grid.Row="1" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="OpenBtn" DockPanel.Dock="Left" Content="Open archive…" Style="{StaticResource DialogPrimary}" Click="Open_Click" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ArchiveTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArchiveStats" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Section}" Padding="10" MinHeight="140">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="UpBtn" DockPanel.Dock="Left" Content="↑  Up" Style="{StaticResource DialogButton}" Click="Up_Click" IsEnabled="False" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DragHint" Text="Drag a box around files to select them, then drag them into a folder to extract them there" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="SelectAllBtn" Content="☑  Select all" Style="{StaticResource DialogButton}" Click="SelectAll_Click" IsEnabled="False" ToolTip="Select everything in this folder (Ctrl+A)" AutomationProperties.AutomationId="SelectAll" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Image x:Name="PathIcon" Source="{StaticResource FolderIcon}" Width="18" Height="18" Margin="0,0,8,0" Visibility="Collapsed" />
                                <TextBlock x:Name="PathText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Size" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Packed" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Modified" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" />
                        </Grid>
                        <Grid>
                            <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                     ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Extended" AllowDrop="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Entry_DoubleClick" KeyDown="EntryList_KeyDown"
                                     PreviewMouseLeftButtonDown="Entry_PreviewMouseDown" PreviewMouseLeftButtonUp="Entry_PreviewMouseUp" PreviewMouseMove="Entry_PreviewMouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Grid Width="22" Height="20" Margin="0,0,8,0">
                                                    <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="EntryName" />
                                                <TextBlock Text="🔒" Margin="6,0,0,0" Visibility="{Binding LockVisibility}" ToolTip="Password protected" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PackedText}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Canvas x:Name="BoxLayer" IsHitTestVisible="False">
                                <Rectangle x:Name="BoxRect" Visibility="Collapsed" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Fill="#335B8DEF" />
                            </Canvas>
                            <StackPanel x:Name="ExtractEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="📦" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="Drop an archive here, or click Open archive…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="ZIP · RAR · 7z · TAR · GZ · BZ2 · XZ · CBZ · CBR" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Section}" Margin="0,10,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Extract to" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <RadioButton x:Name="DestNextRadio" GroupName="xdest" IsChecked="True" Foreground="{DynamicResource TextBrush}" Checked="Dest_Changed"
                                     Content="A new folder next to the archive (named after it)" />
                        <RadioButton x:Name="DestHereRadio" GroupName="xdest" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}" Checked="Dest_Changed"
                                     Content="The same folder as the archive" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="DestOtherRadio" GroupName="xdest" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Checked="Dest_Changed" Content="This folder:" />
                            <TextBox x:Name="DestBox" Grid.Column="1" Style="{StaticResource Field}" Margin="12,0,0,0" IsEnabled="False" />
                            <Button x:Name="DestBrowse" Grid.Column="2" Content="Browse…" Style="{StaticResource DialogButton}" Margin="10,0,0,0" IsEnabled="False" Click="DestBrowse_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="If a file already exists" VerticalAlignment="Top" Margin="0,5,12,0" Foreground="{DynamicResource MutedBrush}" />
                            <WrapPanel x:Name="OverwriteChips" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= create ================= -->
            <Grid x:Name="CreatePanel" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Section}" Padding="12" MinHeight="140">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="CreateTotal" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add files…" Style="{StaticResource DialogButton}" Click="AddFiles_Click" />
                                <Button Content="Add folder…" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="AddFolder_Click" />
                                <Button Content="Remove selected" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="RemoveSel_Click" />
                                <Button Content="Clear" Style="{StaticResource DialogButton}" Margin="8,0,0,0" Click="ClearList_Click" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="CreateList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                     ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Extended" AllowDrop="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="CreateList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="CreateEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="🗜" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="Drop files or folders here, or use Add files… / Add folder…" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Section}" Margin="0,10,0,0" Padding="16,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Format" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <WrapPanel x:Name="FormatChips" />
                        </StackPanel>
                        <TextBlock x:Name="FormatNote" Margin="90,0,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Compression" Width="90" VerticalAlignment="Top" Margin="0,5,0,0" />
                            <WrapPanel x:Name="LevelChips" />
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" VerticalAlignment="Center" />
                            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Field}" />
                        </Grid>
                        <StackPanel x:Name="PasswordPanel" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Password" VerticalAlignment="Center" />
                                <PasswordBox x:Name="PassBox" Grid.Column="1" Height="32" Padding="8,0" VerticalContentAlignment="Center" AutomationProperties.AutomationId="NewPassword"
                                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}" />
                                <PasswordBox x:Name="PassBox2" Grid.Column="2" Height="32" Padding="8,0" VerticalContentAlignment="Center" Margin="10,0,0,0" AutomationProperties.AutomationId="NewPasswordAgain"
                                             Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}" />
                            </Grid>
                            <TextBlock Margin="90,4,0,0" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Optional. Type it twice (second box). Locks the files with AES-256 encryption; file names stay visible, and the password can't be recovered if you forget it." />
                        </StackPanel>
                        <RadioButton x:Name="CreateSameRadio" GroupName="cdest" IsChecked="True" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}" Checked="CreateDest_Changed"
                                     Content="Save next to the first file" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="CreateOtherRadio" GroupName="cdest" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Checked="CreateDest_Changed" Content="This folder:" />
                            <TextBox x:Name="CreateDestBox" Grid.Column="1" Style="{StaticResource Field}" Margin="12,0,0,0" IsEnabled="False" />
                            <Button x:Name="CreateDestBrowse" Grid.Column="2" Content="Browse…" Style="{StaticResource DialogButton}" Margin="10,0,0,0" IsEnabled="False" Click="CreateBrowse_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
