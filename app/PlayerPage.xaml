<UserControl x:Class="IdmClone.PlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent" Drop="Page_Drop" DragOver="Page_DragOver">
    <UserControl.Resources>
        <Style x:Key="RecentRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="player.png" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Video Player" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- the engine (downloaded once) -->
        <Border x:Name="EngineBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,9" CornerRadius="8"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <DockPanel>
                <Button x:Name="EngineBtn" DockPanel.Dock="Right" Content="Download (80 MB)" Style="{StaticResource DialogPrimary}" Margin="12,0,0,0" Click="Engine_Click" AutomationProperties.AutomationId="PlayerEngineInstall" />
                <TextBlock x:Name="EngineText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="The player uses the engine inside VLC, so it opens practically every video and music format. It is downloaded once (about 80 MB) from videolan.org, after you press the button." />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Section}" Margin="0,14,0,10" Padding="16,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="OpenBtn" Style="{StaticResource PrimaryButton}" Content="▶   Open a file…" Height="46" MinWidth="180" Click="OpenFile_Click" AutomationProperties.AutomationId="PlayerOpenFile" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Button Content="Open folder…" Style="{StaticResource LinkButton}" Click="OpenFolder_Click" />
                        <Button Content="Network stream…" Style="{StaticResource LinkButton}" Margin="14,0,0,0" Click="OpenNetwork_Click" />
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Play videos and music" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Drop files here, or open one. Subtitles with the same name next to a video (Movie.srt) turn on by themselves. The player remembers where you stopped." />
                    <TextBlock x:Name="ShortcutNote" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                               Text="In the player: Space pause · F full screen · arrows seek and volume · [ ] speed · V subtitles · B audio track · Shift+S snapshot." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Section}" Padding="12,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,0,6,6">
                    <Button x:Name="ClearBtn" DockPanel.Dock="Right" Content="Clear list" Style="{StaticResource LinkButton}" Click="ClearRecent_Click" />
                    <TextBlock Text="Recently played" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ItemContainerStyle="{StaticResource RecentRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" AutomationProperties.AutomationId="PlayerRecent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="RecentName" />
                                    <TextBlock Text="{Binding Folder}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Resume}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <TextBlock x:Name="EmptyText" Grid.Row="3" Text="Nothing played yet." Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
