<Window x:Class="IdmClone.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13.5">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" />
        <PasswordBox x:Name="Box" Height="34" Padding="8,0" VerticalContentAlignment="Center" FontSize="14"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrBrush}" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="OK" Style="{StaticResource DialogPrimary}" IsDefault="True" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
